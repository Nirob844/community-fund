# Copy to .env for local `netlify dev`. In production set these in
# Netlify > Site configuration > Environment variables. Never commit real values.

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key            # safe to expose; RLS blocks it from all tables
SUPABASE_SERVICE_ROLE_KEY=secret-service-key # SERVER ONLY. Never put in front-end code.

# Stripe (Developers > API keys, Developers > Webhooks)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare Turnstile (free bot protection)
TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Email (Resend: https://resend.com — free tier is enough). Without a key, emails are logged as "skipped".
RESEND_API_KEY=re_...
EMAIL_FROM="Prospect Road Community Fund <fund@yourdomain.org>"   # domain must be verified in Resend
EMAIL_REPLY_TO=treasurer@yourdomain.org
TREASURER_EMAIL=treasurer@yourdomain.org                          # receives dispute alerts

# Activity log: a long random value used to fingerprint IP addresses (never stored in the clear).
# Make one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LOG_SALT=change-me-to-a-long-random-value
