{
  "name": "prospect-road-community-fund",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Pledge, payment and transparency site for the Prospect Road Community Fund.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "netlify dev",
    "check": "node scripts/check.mjs",
    "set-domain": "node scripts/set-domain.mjs",
    "test": "npm run check && npm run test:unit && npm run test:db && npm run test:e2e && npm run test:live",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:live": "node tests/live-page/run.mjs",
    "verify": "node scripts/verify-deploy.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "netlify-cli": "^27.0.0",
    "playwright": "^1.63.0"
  }
}